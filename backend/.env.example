# ---------- SERVER ----------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------- DATABASE ----------
MONGO_URI=your_mongodb_connection_string_here

# ---------- AUTH ----------
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here

# ---------- EMAIL / NODEMAILER (SMTP) ----------
# Set EMAIL_ENABLED=true to actually send emails, false = console-log only (dev mode)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email_address_here
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME=JIMS Placement Portal
EMAIL_FROM_ADDRESS=your_email_address_here
EMAIL_REPLY_TO=your_email_address_here

# ---------- AI (GEMINI) ----------
# Get your key from: https://aistudio.google.com/
# Supported models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
