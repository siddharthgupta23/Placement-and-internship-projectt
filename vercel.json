{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/notifications/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|auth/|notifications/).*)",
      "destination": "/index.html"
    }
  ]
}
